{
  "name": "nuxt-docs-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,ts,vue,css,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "precommit": "npm run typecheck && npm run lint && npm run format",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/tailwindcss": "^6.12.1",
    "@pinia/nuxt": "^1.0.2",
    "chart.js": "^4.5.1",
    "dayjs-nuxt": "^2.1.11",
    "nuxt": "^4.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxt/eslint": "^1.10.0",
    "@nuxt/icon": "^2.1.0",
    "@nuxt/test-utils": "^4.2.0",
    "@nuxtjs/sitemap": "^8.5.0",
    "@pinia/testing": "^2.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^26.4.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.1",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "zod": "^4.5.4"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
